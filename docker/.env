# Loaded automatically by `docker compose` (must be named exactly `.env`,
# sitting next to the compose file) to interpolate ${VAR} references inside
# docker-compose.yml itself -- e.g. NODE_VERSION/JAVA_VERSION below feed the
# build args for frontend/backend, the same ARG each Dockerfile declares.
# This is compose-side substitution, distinct from a service's own
# `env_file:`/`environment:`, which set variables *inside* the container.
NODE_VERSION=20
JAVA_VERSION=21
